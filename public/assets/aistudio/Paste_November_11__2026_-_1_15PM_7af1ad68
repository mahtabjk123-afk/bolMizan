function getTrustScore(name) {
const pDeals = entries.filter(e => e.name.toLowerCase() === name.toLowerCase());
if (!pDeals.length) return 100;
const paid = pDeals.filter(e => e.status === 'Paid').length;
return Math.min(100, Math.max(50, Math.round(((paid + 1) / (pDeals.length + 1)) * 100)));
}
