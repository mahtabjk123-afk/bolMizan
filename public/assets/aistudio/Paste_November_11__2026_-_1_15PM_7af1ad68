function runAudit() {
const name = document.getElementById('matName').value.trim() || 'Item';
const sent = parseFloat(document.getElementById('matSent').value);
const used = parseFloat(document.getElementById('matUsed').value);
const price = parseFloat(document.getElementById('matPrice').value) || 0;
const exp = document.getElementById('matExpiry').value;
const phone = document.getElementById('matPhone').value.trim();
if (isNaN(sent) || isNaN(used)) return alert("Total Stock aur Used/Remaining quantity darj karein.");
const diff = sent - used;
const loss = diff * price;
const pct = sent > 0 ? ((diff / sent) * 100).toFixed(1) : 0;
let expHtml = '';
if (exp) {
const daysLeft = Math.round((new Date(exp) - new Date()) / 86400000);
const offerMsg = encodeURIComponent(*MizanPay Dead-Stock Bachat Offer*\nItem: ${name} (${used} Units)\nExpiry Date: ${exp}\nSpecial Discount Rate: ${price}/unit\nRabta karein taake maal zaya na ho.);
const waOffer = phone ? https://wa.me{phone}?text=${offerMsg} : https://wa.me{offerMsg};
expHtml = <br><strong>⏳ Expiry Status (${daysLeft} days left):</strong>  <a class="btn-sm wa-btn" style="margin-top:6px; display:inline-block;" target="_blank" onclick="recordBachat(${used * price})" href="${waOffer}">WhatsApp Stock Transfer Offer</a>;
}
const box = document.getElementById('auditResult');
if (diff > 0) {
box.innerHTML = <div class="result-card alert-leak"> <strong>⚠️ Leakage / Shortage Pakri Gayi (${name})</strong><br> Total: ${sent} | Accounted: ${used}<br> <strong>Missing Units: ${diff} (${pct}% Leakage)</strong> | Loss: <strong>${loss.toLocaleString()}</strong>${expHtml} </div>;
} else {
box.innerHTML = <div class="result-card"> <strong>✅ 100% Clean Audit (${name})</strong><br> Zero leakage! Tamam ${sent} units ka hisab durust hai.${expHtml} </div>;
}
}
