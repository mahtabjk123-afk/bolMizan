async function sha256(str) {
const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
}
async function addEntry() {
const biz = document.getElementById('bizName').value.trim();
const cat = document.getElementById('category').value;
const name = document.getElementById('personName').value.trim();
const phone = document.getElementById('phone').value.trim();
const amount = parseFloat(document.getElementById('amount').value);
const dueDate = document.getElementById('dueDate').value || new Date(Date.now() + 15*86400000).toISOString().split('T');
const detail = document.getElementById('detail').value.trim() || 'General Trade';
const type = document.getElementById('type').value;
if (!name || !amount) return alert("Party Name aur Amount lazmi darj karein.");
const createdAt = new Date().toISOString();
const hash = await sha256(${biz}|${name}|${amount}|${dueDate}|${detail}|${type}|${createdAt});
entries.unshift({
id: Date.now(), biz, cat, name, phone, amount, originalAmount: amount, dueDate, detail, type,
status: type === 'nakad' ? 'Paid' : 'Pending',
createdAt, paidAt: type === 'nakad' ? createdAt : null, hash, ext: 0
});
localStorage.setItem(DB_KEY, JSON.stringify(entries));
if (biz) localStorage.setItem('mizanUltBiz', biz);
['personName', 'phone', 'amount', 'detail'].forEach(id => document.getElementById(id).value = '');
renderList();
}
function partialPay(id) {
const item = entries.find(x => x.id === id);
if (!item) return;
const qist = parseFloat(prompt(Total Baqi: ${item.amount}. Kitni qist (amount) wasool hui hai?));
if (!qist || qist <= 0) return;
if (qist >= item.amount) {
markPaid(id);
} else {
item.amount -= qist;
item.detail +=  [Qist Paid: ${qist}];
localStorage.setItem(DB_KEY, JSON.stringify(entries));
renderList();
}
}
function markPaid(id) {
const item = entries.find(x => x.id === id);
if (item) {
item.status = 'Paid';
item.paidAt = new Date().toISOString();
localStorage.setItem(DB_KEY, JSON.stringify(entries));
renderList();
}
}
function forgiveDebt(id) {
const item = entries.find(x => x.id === id);
if (!item) return;
if (!confirm(Kya aap Allah ki raza ke liye ${item.name} ke ${item.amount} rupay maaf (Sadqah) karna chahte hain?)) return;
